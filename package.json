{
  "name": "scarcity-stash",
  "private": true,
  "version": "0.1.0",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paritytech/scarcity-stash-community.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:css": "stylelint \"src/**/*.css\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "check": "npm run typecheck && npm run lint && npm run lint:css && npm run format:check && npm run knip && npm test",
    "postinstall": "papi",
    "chain:update": "papi update"
  },
  "dependencies": {
    "@parity/product-sdk-address": "^0.3.1",
    "@parity/product-sdk-chain-client": "0.13.11",
    "@parity/product-sdk-host": "0.35.0",
    "@parity/product-sdk-nfts": "0.5.0",
    "@polkadot-api/descriptors": "file:.papi/descriptors",
    "@sentry/react": "11.8.0",
    "@tanstack/query-core": "^5.107.1",
    "polkadot-api": "^3.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "overrides": {
    "@polkadot-api/json-rpc-provider": "^0.2.0",
    "deepmerge-ts": "^8.0.2"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.24.6",
    "@eslint/js": "^10.0.1",
    "@noble/hashes": "^2.3.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/eslint-plugin": "^1.6.27",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "fake-indexeddb": "^6.2.5",
    "knip": "^6.39.0",
    "neverthrow": "^8.2.0",
    "prettier": "^3.9.9",
    "stylelint": "^17.16.0",
    "stylelint-config-recess-order": "^7.8.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.1.1"
  }
}
