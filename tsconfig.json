{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowImportingTsExtensions": false,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitAny": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": false,
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "noEmit": true,
    "useDefineForClassFields": true,
    "paths": { "@/*": ["./src/*"] }
  },
  // `.papi/whitelist.ts` is typechecked too: it names generated descriptor
  // types, so a chain repoint renames them out from under it. Left out of
  // scope, that drift stays invisible until `papi generate` silently prunes
  // an entry a read needs.
  "include": ["src", ".papi/whitelist.ts"]
}
